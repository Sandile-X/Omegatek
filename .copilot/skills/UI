## 7️⃣ SCROLL-TRIGGERED ANIMATIONS (Better)

### Current Issue
Using AOS is fine, but feels generic

### Solution: Custom Scroll Trigger with Stagger

```javascript
// Replace/enhance current scroll animations
class ScrollReveal {
  constructor(selector, options = {}) {
    this.elements = document.querySelectorAll(selector);
    this.options = {
      threshold: options.threshold || 0.2,
      stagger: options.stagger || 100,
      duration: options.duration || 600,
      ...options
    };
    this.setupObserver();
  }

  setupObserver() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }, this.options.stagger * index);
        }
      });
    }, { threshold: this.options.threshold });

    this.elements.forEach(el => observer.observe(el));
  }
}

// Usage in your script
new ScrollReveal('.service-card', {
  threshold: 0.3,
  stagger: 80,
  duration: 700
});
```

