  try {
    const response = await fetch('gemini-api.php', {
      method: 'POST',
      body: JSON.stringify({ prompt })
    });
    const data = await response.json();
    progressBar.complete();
    return data;
  } catch (err) {
    progressBar.complete();
    throw err;
  }
}
</script>
